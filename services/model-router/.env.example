# 当前模型提供方：qwen、deepseek 或 dify。实时语音默认使用低延迟 qwen。
LLM_PROVIDER=qwen

# Pipecat 官方 Qwen Service；真实密钥只能由服务端密钥系统或本地环境注入。
DASHSCOPE_API_KEY=请替换为百炼服务密钥
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-flash

# OpenAI 兼容模型提供方；真实密钥只能由服务端密钥系统或本地环境注入。
OPENAI_COMPATIBLE_BASE_URL=https://api.deepseek.com
OPENAI_COMPATIBLE_API_KEY=请替换为模型服务密钥
OPENAI_COMPATIBLE_MODEL=deepseek-v4-flash
OPENAI_COMPATIBLE_THINKING=disabled

# 已部署 Dify Chatflow 的接口基地址，必须包含 /v1。
DIFY_CHATFLOW_BASE_URL=https://dify.example.com/v1

# 仅由服务端密钥系统或本地环境注入，禁止提交真实值。
DIFY_CHATFLOW_API_KEY=请替换为 Chatflow 应用密钥

# 以下参数均可选。
DIFY_CHATFLOW_PROVIDER_ID=dify-chatflow-primary
DIFY_CHATFLOW_CONNECT_TIMEOUT_MS=1000
DIFY_CHATFLOW_READ_TIMEOUT_MS=15000
DIFY_CHATFLOW_TOTAL_TIMEOUT_MS=20000
DIFY_CHATFLOW_STOP_TIMEOUT_MS=500
DIFY_CHATFLOW_MAX_RETRIES_BEFORE_DELTA=1

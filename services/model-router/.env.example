# 已部署 Dify 工作流应用的接口基地址，必须包含 /v1。
DIFY_WORKFLOW_BASE_URL=https://dify.example.com/v1

# 仅由服务端密钥系统或本地环境注入，禁止提交真实值。
DIFY_WORKFLOW_API_KEY=请替换为工作流应用密钥

# 以下参数均可选。
DIFY_WORKFLOW_PROVIDER_ID=dify-workflow-primary
DIFY_WORKFLOW_CONNECT_TIMEOUT_MS=1000
DIFY_WORKFLOW_READ_TIMEOUT_MS=15000
DIFY_WORKFLOW_TOTAL_TIMEOUT_MS=20000
DIFY_WORKFLOW_STOP_TIMEOUT_MS=500
DIFY_WORKFLOW_MAX_RETRIES_BEFORE_DELTA=1

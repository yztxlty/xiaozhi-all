# 已部署 Dify Chatflow 的接口基地址，必须包含 /v1。
DIFY_CHATFLOW_BASE_URL=https://dify.example.com/v1

# 仅由服务端密钥系统或本地环境注入，禁止提交真实值。
DIFY_CHATFLOW_API_KEY=请替换为 Chatflow 应用密钥

# 以下参数均可选。
DIFY_CHATFLOW_PROVIDER_ID=dify-chatflow-primary
DIFY_CHATFLOW_CONNECT_TIMEOUT_MS=1000
DIFY_CHATFLOW_READ_TIMEOUT_MS=15000
DIFY_CHATFLOW_TOTAL_TIMEOUT_MS=20000
DIFY_CHATFLOW_STOP_TIMEOUT_MS=500
DIFY_CHATFLOW_MAX_RETRIES_BEFORE_DELTA=1
